{
  "name": "apace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @apace/web dev",
    "build": "pnpm --filter @apace/web build",
    "build:bench": "pnpm --filter @apace/web build:bench",
    "check": "biome check . && tsc -p tsconfig.json && pnpm -r run typecheck",
    "test": "vitest run",
    "e2e": "pnpm build && pnpm build:bench && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
